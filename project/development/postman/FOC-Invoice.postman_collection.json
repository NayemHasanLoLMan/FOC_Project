        },
        {
          "name": "retryInvoiceSave",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/jobs/{{job_id}}/retry-save",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}",
                "retry-save"
              ],
              "query": []
            },
            "description": "Request the running worker to retry its prepared invoice on the next pass; no OCR rerun. Fetch getControls first. Select current IDs. This request changes queue state. For an uncertain retry, replace {{$guid}} with the original request_id before sending again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"{{$guid}}\",\n  \"attempt_id\": {{attempt_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "editInvoice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/jobs/{{job_id}}/edit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "jobs",
                "{{job_id}}",
                "edit"
              ],
              "query": []
            },
            "description": "Save manual invoice changes as a new version through the worker; preserve source readings and previous files. No OCR rerun. Fill changes with intended fields/items before sending; the empty example is rejected. Reuse the same UUID/payload for an uncertain retry. India: changes may include port_of_discharge/shipment_terms; every submitted goods row must also include hs_code (text or null). India rejects destination_country, tin_number and import_cover_note. India totals use cents; Bangladesh keeps its existing contract. Fetch the job region/data first; no country-changing request is supported.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"{{$guid}}\",\n  \"attempt_id\": {{attempt_id}},\n  \"changes\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
