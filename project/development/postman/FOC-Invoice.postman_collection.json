            ],
            "url": {
              "raw": "{{base_url}}/api/queue/resume",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "queue",
                "resume"
              ],
              "query": []
            },
            "description": "Allow new claims by a running worker. Fetch getControls first. Select current IDs. This request changes queue state. For an uncertain retry, replace {{$guid}} with the original request_id before sending again.",
