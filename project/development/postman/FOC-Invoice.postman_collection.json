    {
      "name": "Admin controls - changes queue state",
      "item": [
        {
          "name": "pauseQueue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/queue/pause",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "queue",
                "pause"
              ],
              "query": []
            },
            "description": "Pause new conversions; active work and prepared saves may finish. Fetch getControls first. Select current IDs. This request changes queue state. For an uncertain retry, replace {{$guid}} with the original request_id before sending again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "resumeQueue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{base_url}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/queue/resume",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "queue",
                "resume"
              ],
              "query": []
            },
            "description": "Allow new claims by a running worker. Fetch getControls first. Select current IDs. This request changes queue state. For an uncertain retry, replace {{$guid}} with the original request_id before sending again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
